#!/bin/bash
#PBS -N jepa-p2b-data
#PBS -q gpu_bwp6000
#PBS -l select=1:ncpus=4:ngpus=1:mem=72gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
module load anaconda2025/2025-gpu
: "${JEPA_CONDA_SH:?Set JEPA_CONDA_SH}"
: "${JEPA_CONDA_ENV:?Set JEPA_CONDA_ENV}"
: "${JEPA_MODEL_PATH:?Set JEPA_MODEL_PATH}"
: "${JEPA_ARTIFACT_ROOT:?Set JEPA_ARTIFACT_ROOT}"
source "$JEPA_CONDA_SH"
conda activate "$JEPA_CONDA_ENV"
JEPA_REPO_DIR="${JEPA_REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "$JEPA_REPO_DIR"
export PYTHONPATH="${PWD}/src:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export HF_HOME="${JEPA_HF_HOME:-$JEPA_ARTIFACT_ROOT/huggingface}"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_OFFLINE=1
mkdir -p "$JEPA_ARTIFACT_ROOT/logs"
# Reuse prepared splits; do not rewrite Phase 1's artifacts.
test -s "$JEPA_ARTIFACT_ROOT/data/gsm8k_train.jsonl"
test -s "$JEPA_ARTIFACT_ROOT/data/gsm8k_validation.jsonl"
python -m jepa_pu.trajectories --config configs/phase2b.yaml --split train \
  2>&1 | tee "$JEPA_ARTIFACT_ROOT/logs/phase2b-generate-train.log"
python -m jepa_pu.trajectories --config configs/phase2b.yaml --split validation \
  2>&1 | tee "$JEPA_ARTIFACT_ROOT/logs/phase2b-generate-validation.log"
